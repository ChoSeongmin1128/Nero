{
  "manifest_version": "0.3",
  "name": "nero",
  "display_name": "Nero",
  "version": "0.0.1",
  "description": "Nero 회의 검색, 음성 기록과 요약 조회",
  "author": { "name": "Nero" },
  "icon": "icon.png",
  "server": {
    "type": "binary",
    "entry_point": "server/nero",
    "mcp_config": {
      "command": "${__dirname}/server/nero",
      "args": ["mcp"],
      "env": {}
    }
  },
  "compatibility": { "platforms": ["darwin"] },
  "tools": [
    { "name": "meetings_list", "description": "회의 목록 조회" },
    { "name": "meetings_search", "description": "회의 검색" },
    { "name": "meeting_get", "description": "회의 정보와 메모 조회" },
    { "name": "transcript_get", "description": "음성 기록 조회" },
    { "name": "summary_get", "description": "저장된 요약 조회" },
    { "name": "folders_list", "description": "폴더 목록 조회" },
    { "name": "status", "description": "연결 상태 조회" }
  ]
}
