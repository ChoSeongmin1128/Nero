{
  "manifest_version": "0.3",
  "name": "nero",
  "display_name": "Nero",
  "version": "0.0.1",
  "description": "Nero 회의와 요약 조회, 새 요약 저장, 회의와 요약 템플릿 관리, 처리 작업 조회와 취소",
  "author": {
    "name": "Nero"
  },
  "icon": "icon.png",
  "server": {
    "type": "binary",
    "entry_point": "server/nero",
    "mcp_config": {
      "command": "${__dirname}/server/nero",
      "args": [
        "mcp"
      ],
      "env": {}
    }
  },
  "compatibility": {
    "platforms": [
      "darwin"
    ]
  },
  "tools": [
    {
      "name": "jobs_list",
      "description": "실행 중인 Nero의 처리 작업 상태 조회"
    },
    {
      "name": "job_cancel",
      "description": "사용자가 요청한 처리 작업을 수정본 확인 후 취소"
    },
    {
      "name": "meetings_list",
      "description": "회의 목록 조회"
    },
    {
      "name": "meetings_search",
      "description": "회의 검색"
    },
    {
      "name": "meeting_get",
      "description": "회의 정보와 메모 조회"
    },
    {
      "name": "transcript_get",
      "description": "음성 기록 조회"
    },
    {
      "name": "summary_get",
      "description": "저장된 요약 조회"
    },
    {
      "name": "summary_context",
      "description": "참석 명단과 요약 저장에 필요한 원문/메모/명단/기존 요약 수정본 조회"
    },
    {
      "name": "summary_import",
      "description": "에이전트가 생성한 요약을 Nero에 저장"
    },
    {
      "name": "folders_list",
      "description": "폴더 목록 조회"
    },
    {
      "name": "people_catalog",
      "description": "관리 인원과 그룹 조회"
    },
    {
      "name": "people_update",
      "description": "관리 인원과 그룹 수정"
    },
    {
      "name": "meeting_attendees_set",
      "description": "회의 참석 명단 수정"
    },
    {
      "name": "meeting_attendee_promote",
      "description": "회의 참석자를 관리 인원으로 저장"
    },
    {
      "name": "status",
      "description": "저장소 확인"
    },
    {
      "name": "templates_list",
      "description": "요약 템플릿 목록 조회"
    },
    {
      "name": "template_get",
      "description": "요약 템플릿 지침 조회"
    },
    {
      "name": "template_create",
      "description": "요약 템플릿 추가"
    },
    {
      "name": "template_update",
      "description": "요약 템플릿 수정"
    },
    {
      "name": "template_delete",
      "description": "사용자 템플릿 삭제"
    },
    {
      "name": "template_reset",
      "description": "기본 템플릿 복원"
    },
    {
      "name": "meeting_update",
      "description": "회의 제목과 메모 수정"
    },
    {
      "name": "meeting_date_set",
      "description": "회의 날짜 수정"
    },
    {
      "name": "meetings_move",
      "description": "회의 폴더 이동"
    },
    {
      "name": "meetings_trash",
      "description": "회의를 휴지통으로 이동"
    },
    {
      "name": "meetings_restore",
      "description": "휴지통 회의 복원"
    },
    {
      "name": "folder_create",
      "description": "회의 폴더 추가"
    },
    {
      "name": "folder_rename",
      "description": "회의 폴더 이름 수정"
    },
    {
      "name": "folder_delete",
      "description": "회의 폴더 삭제"
    }
  ]
}
