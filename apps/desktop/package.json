{
  "name": "nero-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "version:check": "node scripts/version.mjs check",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "prepare:shared": "node scripts/prepare-shared.mjs",
    "prepare:agent": "node scripts/prepare-agent.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "dev": "npm run prepare:shared && vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run version:check && npm run prepare:shared && vite build",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tauri-apps/api": "2.12.4",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "vite": "8.3.4"
  }
}
