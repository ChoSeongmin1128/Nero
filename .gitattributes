# Preserve upstream license text.
Sources/GroveApp/Resources/Fonts/OFL.txt -whitespace

# Keep design token source hashes identical on macOS and Windows.
design-system/** text eol=lf
design-system/vendor/pretendard/*.woff2 binary
design-system/vendor/pretendard/LICENSE.txt -whitespace

# Unified diff context lines contain required spaces; preserve the pinned patch bytes.
scripts/native-moss-harness/patches/*.patch text eol=lf -whitespace

# Preserve the exact verified native speech patch, including diff context spaces.
scripts/native-diarization/patches/*.patch text eol=lf -whitespace

# Preserve the unmodified decoder license notice.
apps/desktop/licenses/audio-decode/MPL-2.0.txt -whitespace

# Keep the small patched upstream AAC dependency reproducible across hosts.
vendor/symphonia-codec-aac/** text eol=lf
vendor/symphonia-codec-aac/LICENSE -whitespace

# Preserve hash-pinned upstream notice bytes across checkout settings.
apps/desktop/licenses/models/** -text
apps/desktop/licenses/rust-supplements/** -text
