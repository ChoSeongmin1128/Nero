--- /dev/null
+++ b/src/runtime/ggml/scheduler_capacity.h
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstddef>
+namespace ggml_runtime {
+// Retain scheduler headroom and the original upper bound; no model/audio changes.
+inline size_t scheduler_capacity_for(size_t nodes, size_t current, size_t maximum) {
+    while (current < maximum && nodes > current * 9 / 10) {
+        current = current > maximum / 2 ? maximum : current * 2;
+    }
+    return current;
+}
+}
--- /dev/null
+++ b/tests/cpp/asr/test_windows_scheduler_capacity.cpp
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "scheduler_capacity.h"
+#include <cstdio>
+int main() {
+    using ggml_runtime::scheduler_capacity_for;
+    if (scheduler_capacity_for(63, 2048, 65536) != 2048) return 1;
+    if (scheduler_capacity_for(2733, 2048, 65536) != 4096) return 2;
+    if (scheduler_capacity_for(4000, 2048, 65536) != 8192) return 3;
+    if (scheduler_capacity_for(60000, 2048, 65536) != 65536) return 4;
+    if (scheduler_capacity_for(65536, 65536, 65536) != 65536) return 5;
+    std::puts("scheduler capacity/headroom/bound checks passed");
+    return 0;
+}
